# ── Database ────────────────────────────────────────────────────────────────
# Local development: `npm run db:local` starts PostgreSQL on port 5433 with these credentials.
DATABASE_URL="postgresql://hanziquest:hanziquest@localhost:5433/hanziquest"
# Used only by integration tests (tests are destructive — never point this at real data).
TEST_DATABASE_URL="postgresql://hanziquest:hanziquest@localhost:5433/hanziquest_test"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Set to the deployed origin in production, e.g. https://hanziquest.example.com
AUTH_URL="http://localhost:3000"
# Set to "true" when running behind a trusted proxy (e.g. Vercel sets this automatically).
AUTH_TRUST_HOST="true"

# ── Rate limits (optional) ──────────────────────────────────────────────────
# Registrations allowed per IP per hour (default 5). Raised only for automated tests.
REGISTER_LIMIT_PER_HOUR=""

# ── Registration ────────────────────────────────────────────────────────────
# "invite" (the default in production): sign-up needs a code from Admin → Invites.
# "open": anyone can register (the default in development). Keep production invite-only
# until the owner approves the legal and operational prerequisites.
REGISTRATION_MODE=""

# ── Password reset links (D-045, D-047) ─────────────────────────────────────
# Staff-issued reset links. Off by default in production; "on" only after the owner has
# approved the procedure in docs/SECURITY.md. "off" disables them in any environment.
PASSWORD_RESET_LINKS=""

# ── Seed: initial super admin (optional) ────────────────────────────────────
# If both are set, `npm run db:seed` creates or promotes this account to SUPER_ADMIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Proxy and rate limiting ────────────────────────────────────────────────
# How many trusted proxies append to X-Forwarded-For in front of the app (default 1).
# 0 = the app is exposed directly; forwarding headers are then ignored.
TRUSTED_PROXY_HOPS="1"

# Connection pool size per app instance (1-100, default 10). Keep instances × pool below the
# database's connection limit; with a pooled (PgBouncer) URL, 5-10 is plenty.
DATABASE_POOL_MAX=""
# "postgres" (default in production; shared across instances) or "memory" (per process).
RATE_LIMIT_STORE=""

# ── Monitoring ──────────────────────────────────────────────────────────────
# Sentry or a Sentry-compatible service (e.g. self-hosted GlitchTip). Errors always go to stdout
# as JSON lines; with a DSN they are also sent there. Leave empty to disable.
SENTRY_DSN=""
# Shown in /api/health and attached to error reports, e.g. the git commit SHA.
APP_RELEASE=""
# Environment label for error reports, e.g. "production" or "staging".
APP_ENV=""

# ── Advanced ────────────────────────────────────────────────────────────────
# Location of the hanzi-writer-data package if the app runs outside the project directory.
HANZI_WRITER_DATA_DIR=""
# Skip the start-up configuration check (build pipelines only; never in production).
SKIP_ENV_CHECK=""

# ── Handwriting erasure ledger (CLI only; D-062) ────────────────────────────
# Signing key for the erasure ledger (npm run handwriting:erasures, db:restore --erasure-ledger).
# Owner-held: generate with `openssl rand -base64 48`, keep it in a password manager. Never put
# the real key in a committed file, on Render or in GitHub. The app itself doesn't need it.
ERASURE_LEDGER_KEY=""
