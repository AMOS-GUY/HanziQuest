# ── Database ────────────────────────────────────────────────────────────────
# Local development: `npm run db:local` starts PostgreSQL on port 5433 with these credentials.
DATABASE_URL="postgresql://hanziquest:hanziquest@localhost:5433/hanziquest"
# Used only by integration tests (tests are destructive — never point this at real data).
TEST_DATABASE_URL="postgresql://hanziquest:hanziquest@localhost:5433/hanziquest_test"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Set to the deployed origin in production, e.g. https://hanziquest.example.com
AUTH_URL="http://localhost:3000"
# Set to "true" when running behind a trusted proxy (e.g. Vercel sets this automatically).
AUTH_TRUST_HOST="true"

# ── Seed: initial super admin (optional) ────────────────────────────────────
# If both are set, `npm run db:seed` creates or promotes this account to SUPER_ADMIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Monitoring (optional, not yet integrated) ───────────────────────────────
SENTRY_DSN=""
