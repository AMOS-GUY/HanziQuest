// HanziQuest database schema.
// See docs/DATABASE.md for the design rationale behind each domain.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleKey {
  SUPER_ADMIN
  CURRICULUM_EDITOR
  MODERATOR
  ANALYST
  SUPPORT
  LEARNER
}

enum ExperienceLevel {
  NEW
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CurriculumFramework {
  HSK_2_0
  HSK_3_0
  CUSTOM
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// How trustworthy a content record is. Only VERIFIED content may be labelled official.
enum VerificationStatus {
  PROVISIONAL
  REVIEWED
  VERIFIED
}

enum LicenseStatus {
  UNKNOWN
  OPEN_LICENSE
  LICENSED
  ORIGINAL
  PUBLIC_FACT
}

enum CharacterAssetType {
  STROKE_DATA
  AUDIO
  IMAGE
}

enum ExerciseType {
  PINYIN_TO_HANZI
  MEANING_TO_HANZI
  GUIDED_STROKE
  FREEHAND_WRITING
  CHARACTER_RECONSTRUCTION
  LISTENING_TO_WRITING
}

enum PracticeMode {
  GUIDED
  INDEPENDENT
}

enum AttemptResult {
  EXCELLENT
  GOOD
  NEEDS_IMPROVEMENT
  TRY_AGAIN
  SKIPPED
}

enum MasteryLevel {
  NEW
  LEARNING
  FAMILIAR
  MASTERED
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
  /// Unlocked by the placement assessment without being completed.
  TESTED_OUT
}

enum LearningSessionType {
  LESSON
  REVIEW
  PRACTICE
  ASSESSMENT
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum XPReason {
  EXERCISE_COMPLETED
  LESSON_COMPLETED
  REVIEW_COMPLETED
  DAILY_GOAL_MET
  ACHIEVEMENT_EARNED
  ADMIN_ADJUSTMENT
}

enum SyncEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
}

/// What a handwriting validation sample deliberately contains (ground truth label).
enum HandwritingSampleCategory {
  CORRECT
  WRONG_CHARACTER
  MISSING_STROKE
  EXTRA_STROKE
  WRONG_DIRECTION
  WRONG_ORDER
  POOR_SHAPE
}

/// Lifecycle of a pilot participant code (M12). Only ACTIVE codes with current consent may
/// have samples recorded. WITHDRAWN and RETENTION_ENDED are tombstones: the code's samples
/// have been erased and the code can never collect again.
enum PilotParticipantStatus {
  ACTIVE
  WITHDRAWN
  RETENTION_ENDED
}

/// Fixed collector observations about one sample (M12). Replaces free-text notes so that no
/// names or identifying details can be typed into the lab.
enum HandwritingObservation {
  HESITATED
  RESTARTED
  USED_UNDO
  UNSURE_OF_CHARACTER
  INSTRUCTION_MISUNDERSTOOD
  DIFFERENT_ERROR_THAN_ASKED
  WROTE_OUTSIDE_BOX
  DEVICE_LAG_OR_PALM_TOUCH
  INTERRUPTED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  IN_GRACE_PERIOD
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  emailVerified        DateTime?
  name                 String?
  image                String?
  /// bcrypt hash. Null for users who only sign in through an OAuth provider.
  passwordHash         String?
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?
  /// Sessions issued before this instant are rejected (set on password change).
  credentialsChangedAt DateTime?
  /// The beta invite used to register (null for open registration and staff-created accounts).
  inviteId             String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  roles               UserRole[]                 @relation("UserRoles")
  rolesAssigned       UserRole[]                 @relation("RoleAssigner")
  learningSessions    LearningSession[]
  lessonProgress      LessonProgress[]
  attempts            ExerciseAttempt[]
  characterResults    AttemptCharacterResult[]
  masteries           CharacterMastery[]
  reviewSchedules     ReviewSchedule[]
  learningGoals       LearningGoal[]
  assessments         PlacementAssessment[]
  xpTransactions      XPTransaction[]
  achievements        UserAchievement[]
  dailyActivities     DailyActivity[]
  streak              Streak?
  devices             Device[]
  syncEvents          SyncEvent[]
  downloadedContent   DownloadedContentVersion[]
  auditLogs           AuditLog[]
  contentRevisions    ContentRevision[]
  subscriptions       Subscription[]
  paymentCustomers    PaymentCustomer[]
  paymentTransactions PaymentTransaction[]
  entitlements        Entitlement[]
  handwritingSamples  HandwritingSample[]
  pilotParticipants   PilotParticipant[]
  pilotConsents       PilotConsent[]
  feedback            Feedback[]
  invite              BetaInvite?                @relation("InviteRedemptions", fields: [inviteId], references: [id], onDelete: SetNull)
  passwordResets      PasswordResetToken[]

  @@index([status])
}

model Profile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  displayName            String
  experienceLevel        ExperienceLevel @default(NEW)
  /// Self-reported. Never treated as proven mastery (see placement assessment).
  declaredHskLevel       Int?
  declaredLessonNote     String?
  learningObjectives     String[]
  dailyGoalXp            Int             @default(30)
  timezone               String          @default("UTC")
  locale                 String          @default("en")
  notificationsEnabled   Boolean         @default(true)
  reviewRemindersEnabled Boolean         @default(true)
  onboardingCompletedAt  DateTime?
  /// When the learner accepted the beta terms and privacy notice, and which version.
  termsAcceptedAt        DateTime?
  termsVersion           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Auth.js OAuth account link.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js database session (unused while the JWT strategy is active; kept for adapter compatibility).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  users UserRole[]
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Curriculum
// ─────────────────────────────────────────────────────────────────────────────

/// A versioned curriculum, e.g. "HSK 2.0 starter v1". Content is never shared
/// silently between versions: lessons and exercises belong to exactly one version.
model Curriculum {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  framework     CurriculumFramework
  version       String
  description   String?
  status        PublicationStatus   @default(DRAFT)
  source        String
  /// Ids of entries in the source register (content/sources.json) (M14).
  sourceRefs    String[]            @default([])
  licenseStatus LicenseStatus       @default(UNKNOWN)
  verification  VerificationStatus  @default(PROVISIONAL)
  publishedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  levels      HSKLevel[]
  exercises   Exercise[]
  attempts    ExerciseAttempt[]
  assessments PlacementAssessment[]

  @@unique([framework, version])
}

model HSKLevel {
  id           String   @id @default(cuid())
  curriculumId String
  level        Int
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  units      Unit[]

  @@unique([curriculumId, level])
}

model Unit {
  id          String   @id @default(cuid())
  levelId     String
  slug        String
  title       String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  level   HSKLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([levelId, slug])
  @@index([levelId, position])
}

model Lesson {
  id             String            @id @default(cuid())
  unitId         String
  slug           String
  title          String
  description    String?
  position       Int
  status         PublicationStatus @default(DRAFT)
  /// Incremented whenever the lesson's learner-facing content changes; offline packages compare against it.
  contentVersion Int               @default(1)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  unit              Unit                       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  vocabulary        LessonVocabulary[]
  characters        LessonCharacter[]
  exercises         LessonExercise[]
  learningSessions  LearningSession[]
  progress          LessonProgress[]
  downloadedContent DownloadedContentVersion[]

  @@unique([unitId, slug])
  @@index([unitId, position])
  @@index([status])
}

/// A single Chinese character. Independent of any curriculum version.
model Character {
  id                 String             @id @default(cuid())
  /// Simplified form.
  hanzi              String             @unique
  traditional        String?
  /// Primary reading with tone marks, e.g. "nǐ".
  pinyin             String
  pinyinAlternatives String[]
  meaning            String
  radical            String?
  /// Derived from verified stroke data where available.
  strokeCount        Int?
  hasStrokeData      Boolean            @default(false)
  source             String
  /// Ids of entries in the source register (content/sources.json) this record draws on (M14).
  sourceRefs         String[]           @default([])
  licenseStatus      LicenseStatus      @default(UNKNOWN)
  verification       VerificationStatus @default(PROVISIONAL)
  /// Per-standard membership tags (M14). Null means "not tagged", never "not in the level".
  /// Set only from a registered, approved list source.
  hsk20Level         Int?
  hsk30Level         Int?
  /// HSK 3.0 handwriting list membership (null: not tagged).
  hsk30Handwriting   Boolean?
  /// Who last raised verification (a role, never a name) and when (M14).
  reviewerRole       String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  strokes         CharacterStroke[]
  assets          CharacterAsset[]
  vocabulary      VocabularyCharacter[]
  lessons         LessonCharacter[]
  exercises       Exercise[]
  attempts        ExerciseAttempt[]
  attemptResults  AttemptCharacterResult[]
  masteries       CharacterMastery[]
  reviewSchedules ReviewSchedule[]
  assessmentItems AssessmentResult[]
  samples         HandwritingSample[]
}

/// Reference stroke geometry (from hanzi-writer-data / Make Me a Hanzi).
/// Coordinates use the 1024x1024 Make Me a Hanzi space.
model CharacterStroke {
  id          String @id @default(cuid())
  characterId String
  strokeIndex Int
  /// SVG outline path of the stroke.
  path        String
  /// Ordered median points [[x, y], ...] from stroke start to end.
  median      Json

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, strokeIndex])
}

model CharacterAsset {
  id            String             @id @default(cuid())
  characterId   String
  type          CharacterAssetType
  url           String
  source        String
  licenseStatus LicenseStatus      @default(UNKNOWN)
  checksum      String?
  createdAt     DateTime           @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, type])
}

/// A word (one or more characters). Tracked separately from character mastery.
model Vocabulary {
  id                  String              @id @default(cuid())
  simplified          String
  traditional         String?
  pinyin              String
  meaning             String
  partOfSpeech        String?
  audioUrl            String?
  exampleZh           String?
  examplePinyin       String?
  exampleEn           String?
  /// Source register id for the example sentence (M14).
  exampleSourceRef    String?
  exampleVerification VerificationStatus?
  source              String
  /// Ids of entries in the source register (content/sources.json) this record draws on (M14).
  sourceRefs          String[]            @default([])
  licenseStatus       LicenseStatus       @default(UNKNOWN)
  verification        VerificationStatus  @default(PROVISIONAL)
  /// Per-standard membership tags (M14). Null means "not tagged". Set only from a registered,
  /// approved list source.
  hsk20Level          Int?
  hsk30Level          Int?
  reviewerRole        String?
  reviewedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  characters VocabularyCharacter[]
  lessons    LessonVocabulary[]
  exercises  Exercise[]

  @@unique([simplified, pinyin])
}

model VocabularyCharacter {
  vocabularyId String
  characterId  String
  position     Int

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  character  Character  @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([vocabularyId, position])
  @@index([characterId])
}

model LessonVocabulary {
  lessonId     String
  vocabularyId String
  position     Int

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Restrict)

  @@id([lessonId, vocabularyId])
  @@index([vocabularyId])
}

/// Characters taught in a lesson. `isNew` marks the first lesson that introduces the character.
model LessonCharacter {
  lessonId    String
  characterId String
  position    Int
  isNew       Boolean @default(true)

  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([lessonId, characterId])
  @@index([characterId])
}

model Exercise {
  id               String            @id @default(cuid())
  /// Stable key from the content source, unique within a curriculum version.
  key              String
  curriculumId     String
  type             ExerciseType
  /// Structured prompt, e.g. { "pinyin": "nǐ hǎo" } or { "meaning": "thank you" }.
  prompt           Json
  expectedAnswer   String
  characterId      String?
  vocabularyId     String?
  difficulty       Int               @default(1)
  audioUrl         String?
  hint             String?
  evaluationConfig Json
  status           PublicationStatus @default(PUBLISHED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  curriculum      Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  character       Character?         @relation(fields: [characterId], references: [id], onDelete: Restrict)
  vocabulary      Vocabulary?        @relation(fields: [vocabularyId], references: [id], onDelete: Restrict)
  lessons         LessonExercise[]
  attempts        ExerciseAttempt[]
  assessmentItems AssessmentResult[]

  @@unique([curriculumId, key])
  @@index([characterId])
  @@index([vocabularyId])
}

model LessonExercise {
  lessonId   String
  exerciseId String
  position   Int

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([lessonId, exerciseId])
  @@index([lessonId, position])
}

// ─────────────────────────────────────────────────────────────────────────────
// Learning
// ─────────────────────────────────────────────────────────────────────────────

model LearningSession {
  id          String              @id @default(cuid())
  userId      String
  lessonId    String?
  deviceId    String?
  type        LearningSessionType
  startedAt   DateTime            @default(now())
  endedAt     DateTime?
  /// Set when every exercise in the lesson was attempted during this session.
  completedAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  device   Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  attempts ExerciseAttempt[]

  @@index([userId, startedAt])
}

/// Per-learner lesson state. Absent row = not started. Locking is derived (see features/progression).
model LessonProgress {
  userId      String
  lessonId    String
  status      LessonProgressStatus
  startedAt   DateTime             @default(now())
  completedAt DateTime?
  updatedAt   DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
}

/// Immutable history of every exercise attempt. Derived state (mastery, reviews, XP) is recomputed from it.
model ExerciseAttempt {
  id            String        @id @default(cuid())
  /// Client-generated UUID; makes online submission and offline sync idempotent.
  clientEventId String        @unique
  userId        String
  exerciseId    String
  characterId   String?
  sessionId     String?
  deviceId      String?
  curriculumId  String
  mode          PracticeMode
  result        AttemptResult
  /// Overall score 0–100 where the engine supports it; null otherwise.
  score         Float?
  /// Normalised strokes captured from the canvas.
  strokeData    Json?
  /// Per-dimension evaluation output from the handwriting engine.
  evaluation    Json?
  hintsUsed     Int           @default(0)
  durationMs    Int?
  /// When the learner made the attempt (client clock).
  occurredAt    DateTime
  /// When the server stored it.
  receivedAt    DateTime      @default(now())
  /// Learner's local calendar day of `occurredAt` (their timezone at processing time).
  localDate     DateTime?     @db.Date
  xpAwarded     Int           @default(0)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  character  Character?       @relation(fields: [characterId], references: [id], onDelete: Restrict)
  session    LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  device     Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  curriculum Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  characterResults AttemptCharacterResult[]

  @@index([userId, occurredAt])
  @@index([userId, characterId, occurredAt])
  @@index([exerciseId])
  @@index([userId, exerciseId, localDate])
  /// Lesson completion reads a session's attempts; also serves the SET NULL cascade.
  @@index([sessionId])
}

/// Per-character outcome of an attempt (a word attempt yields one row per character).
/// Mastery and review schedules are replayed from these rows in `occurredAt` order, so offline
/// attempts that arrive late still land in the right place in the learner's history.
model AttemptCharacterResult {
  attemptId   String
  position    Int
  userId      String
  characterId String
  mode        PracticeMode
  result      AttemptResult
  score       Float?
  /// Stroke order and direction correct? Null when not judged (guided, skipped or recall failed).
  techniqueOk Boolean?
  occurredAt  DateTime

  attempt   ExerciseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([attemptId, position])
  @@index([userId, characterId, occurredAt])
}

/// Derived per-character mastery. Guided and independent performance are tracked separately.
model CharacterMastery {
  userId                    String
  characterId               String
  level                     MasteryLevel @default(NEW)
  /// 0–1 estimate of retrieval strength.
  strength                  Float        @default(0)
  guidedAttempts            Int          @default(0)
  guidedSuccesses           Int          @default(0)
  independentAttempts       Int          @default(0)
  independentSuccesses      Int          @default(0)
  consecutiveIndependent    Int          @default(0)
  /// Independent recalls whose stroke order and direction were judged.
  techniqueAttempts         Int          @default(0)
  techniqueClean            Int          @default(0)
  /// Clean-technique recalls in a row; MASTERED needs at least 2.
  consecutiveCleanTechnique Int          @default(0)
  lastTechniqueOk           Boolean?
  firstSeenAt               DateTime     @default(now())
  lastPracticedAt           DateTime?
  updatedAt                 DateTime     @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([userId, characterId])
  @@index([userId, level])
}

model ReviewSchedule {
  id             String    @id @default(cuid())
  userId         String
  characterId    String
  dueAt          DateTime
  intervalDays   Float     @default(0)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([userId, characterId])
  @@index([userId, dueAt])
}

model LearningGoal {
  id        String   @id @default(cuid())
  userId    String
  /// e.g. "daily_xp", "hsk_level".
  type      String
  target    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model PlacementAssessment {
  id             String           @id @default(cuid())
  userId         String
  curriculumId   String
  status         AssessmentStatus @default(IN_PROGRESS)
  estimatedLevel Int?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculum Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  results    AssessmentResult[]

  @@index([userId, startedAt])
}

model AssessmentResult {
  id             String   @id @default(cuid())
  assessmentId   String
  exerciseId     String?
  characterId    String?
  correct        Boolean
  score          Float?
  responseTimeMs Int?
  createdAt      DateTime @default(now())

  assessment PlacementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  exercise   Exercise?           @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  character  Character?          @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Gamification
// ─────────────────────────────────────────────────────────────────────────────

/// Server-authoritative XP ledger. Balance = SUM(amount). Never written from client-supplied values.
model XPTransaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  reason         XPReason
  sourceType     String?
  sourceId       String?
  /// Prevents double awards, e.g. "attempt:<clientEventId>".
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  icon        String
  criteria    Json
  xpReward    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@id([userId, achievementId])
}

/// One row per learner per local calendar day (in the learner's timezone).
model DailyActivity {
  userId             String
  date               DateTime @db.Date
  xpEarned           Int      @default(0)
  exercisesCompleted Int      @default(0)
  goalMet            Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model Streak {
  userId         String    @id
  currentLength  Int       @default(0)
  longestLength  Int       @default(0)
  lastActiveDate DateTime? @db.Date
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Offline
// ─────────────────────────────────────────────────────────────────────────────

model Device {
  id         String   @id @default(cuid())
  userId     String
  /// Client-generated stable identifier stored in IndexedDB.
  clientId   String
  label      String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncEvents        SyncEvent[]
  learningSessions  LearningSession[]
  attempts          ExerciseAttempt[]
  downloadedContent DownloadedContentVersion[]

  @@unique([userId, clientId])
}

/// Inbox of events uploaded by devices. `id` is the client event UUID, giving idempotency.
model SyncEvent {
  id              String          @id
  userId          String
  deviceId        String
  type            String
  payload         Json
  status          SyncEventStatus @default(RECEIVED)
  error           String?
  clientCreatedAt DateTime
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@index([status])
}

model DownloadedContentVersion {
  id             String   @id @default(cuid())
  userId         String
  deviceId       String
  lessonId       String
  contentVersion Int
  downloadedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([deviceId, lessonId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Administration
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

/// Snapshot of curriculum content before each admin edit, enabling non-destructive updates and rollback.
model ContentRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  revision   Int
  data       Json
  authorId   String?
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, revision])
}

// ─────────────────────────────────────────────────────────────────────────────
// Future monetization (schema only — no payment provider is integrated)
// ─────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id         String          @id @default(cuid())
  key        String          @unique
  name       String
  interval   BillingInterval
  /// Price in minor units of `currency` (e.g. cents). Currency is never assumed.
  priceMinor Int
  currency   String
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  status                 SubscriptionStatus
  provider               String
  providerSubscriptionId String?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  graceUntil             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
}

model PaymentCustomer {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  providerCustomerId String
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@index([userId])
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  userId                String
  subscriptionId        String?
  provider              String
  providerTransactionId String
  amountMinor           Int
  currency              String
  status                PaymentStatus
  createdAt             DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  @@index([userId])
}

/// Raw provider webhook events, stored once per provider event ID.
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
}

/// What a user may access. Checked server-side; never derived from client state.
model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  key        String
  source     String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, key])
}

// ─────────────────────────────────────────────────────────────────────────────
// Quality and operations
// ─────────────────────────────────────────────────────────────────────────────

/// Labelled real handwriting collected from consenting testers to validate the evaluation
/// engine (docs/HANDWRITING_VALIDATION.md). Participants are identified only by a code.
model HandwritingSample {
  id               String                    @id @default(cuid())
  collectorId      String?
  /// Pseudonymous participant code chosen by the collector (e.g. "P07"). Never a name or email.
  participantCode  String
  /// The participant record (M12). Null only for samples recorded before M12.
  participantId    String?
  /// The consent under which this sample was recorded (M12). Null only before M12.
  consentId        String?
  characterId      String
  category         HandwritingSampleCategory
  /// Ground truth: should the engine accept this (EXCELLENT or GOOD)? True only for CORRECT.
  shouldAccept     Boolean
  /// For WRONG_CHARACTER samples: the character actually written.
  writtenHanzi     String?
  /// One of the fixed prompt styles (normal, small-or-fast, deliberate-error, small, fast, large).
  style            String?
  inputDevice      String?
  canvasSizePx     Int?
  /// Captured automatically: screen size, pixel ratio, pointer type, browser family, OS family.
  deviceInfo       Json?
  strokes          Json
  /// Engine result at collection time. Metrics are recomputed with the current engine.
  engineVersion    String
  band             String
  score            Float
  identityVerified Boolean
  /// Deprecated (M12): free text is no longer written. Kept for pre-M12 rows until a contract
  /// migration drops it; erased with the participant's other data.
  notes            String?
  /// Fixed collector observations (M12), instead of free text.
  observations     HandwritingObservation[]  @default([])
  consentConfirmed Boolean
  createdAt        DateTime                  @default(now())

  collector   User?             @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  character   Character         @relation(fields: [characterId], references: [id], onDelete: Restrict)
  participant PilotParticipant? @relation(fields: [participantId], references: [id], onDelete: Restrict)
  consent     PilotConsent?     @relation(fields: [consentId], references: [id], onDelete: Restrict)

  @@index([category])
  @@index([participantCode])
  @@index([participantId])
  @@index([consentId])
}

/// A pseudonymous pilot participant (M12). Holds no name, contact or demographic data: the
/// code-to-person key and the signed consent form stay on paper, outside the app. After
/// withdrawal the row remains as a tombstone so the code can't be reused for collection.
model PilotParticipant {
  id          String                 @id @default(cuid())
  /// Upper-case code such as "P01" (letters, digits and "-", at most 16).
  code        String                 @unique
  status      PilotParticipantStatus @default(ACTIVE)
  createdById String?
  /// Set when the participant's data was erased (withdrawal or end of retention).
  erasedAt    DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  consents  PilotConsent[]
  samples   HandwritingSample[]

  @@index([status])
}

/// One acceptance of one version of the written consent form (M12), as witnessed by the
/// collector. A new form version needs a new acceptance. Revoked on withdrawal.
model PilotConsent {
  id            String    @id @default(cuid())
  participantId String
  /// Version of the written form, e.g. "pilot-v0.1" (features/handwriting/consent.ts).
  version       String
  /// When the participant signed the paper form (as entered by the collector).
  acceptedAt    DateTime
  recordedById  String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  participant PilotParticipant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  recordedBy  User?               @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  samples     HandwritingSample[]

  @@unique([participantId, version])
  @@index([participantId])
}

/// Which deployment this database belongs to ("staging" or "production"), written once when a
/// new database is first deployed (M11, D-054). Readiness refuses to serve when it doesn't match
/// APP_ENV, so staging can't run against production data or the reverse. A single row, no FKs.
model DeploymentMarker {
  id          Int      @id @default(1)
  environment String
  createdAt   DateTime @default(now())
}

/// Fixed-window counters for the shared rate limiter (multi-instance safe).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

enum FeedbackKind {
  BUG
  IDEA
  CONTENT
  HANDWRITING
  OTHER
}

enum FeedbackStatus {
  NEW
  TRIAGED
  RESOLVED
  CLOSED
}

/// In-app beta feedback and bug reports.
model Feedback {
  id           String         @id @default(cuid())
  userId       String?
  kind         FeedbackKind
  message      String
  pagePath     String?
  appRelease   String?
  userAgent    String?
  allowContact Boolean        @default(false)
  status       FeedbackStatus @default(NEW)
  staffNote    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Beta invitation (M9, D-041). Only a SHA-256 hash of the code is stored; the code is shown
/// once when created. Redemption is atomic: `uses` is incremented with a guarded update inside
/// the registration transaction.
model BetaInvite {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  /// Who or what the invite is for (e.g. "Pilot school A"). Avoid personal data.
  label       String
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  /// Creator's user id. Deliberately not a foreign key: User.inviteId already references this
  /// table, and the backup/restore tools require an acyclic foreign-key graph. The audit log
  /// records who created each invite.
  createdById String?
  createdAt   DateTime  @default(now())
  users       User[]    @relation("InviteRedemptions")

  @@index([createdAt])
}

/// Staff-issued, single-use password reset link (integration audit, D-045). There is no email
/// provider yet, so staff hand the link to the learner themselves. Only a SHA-256 hash of the
/// token is stored; the link is shown once.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Issuer's user id. Not a foreign key (like BetaInvite.createdById); the audit log records it.
  createdById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
