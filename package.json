{
  "name": "hanziquest",
  "version": "0.1.0",
  "private": true,
  "description": "HanziQuest — Chinese character handwriting and learning platform (PWA)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "content:validate": "tsx scripts/content.ts validate",
    "content:import": "tsx scripts/content.ts import",
    "content:preview": "tsx scripts/content.ts preview",
    "content:coverage": "tsx scripts/content.ts coverage",
    "content:report": "tsx scripts/content-report.ts",
    "content:provenance": "tsx scripts/content-provenance.ts",
    "brand:icons": "tsx scripts/generate-icons.ts",
    "progress:rebuild": "tsx scripts/rebuild-progress.ts",
    "handwriting:report": "tsx scripts/handwriting-report.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:environment": "tsx scripts/db-environment.ts",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "staging:db:inspect": "tsx --env-file=.env.staging.local scripts/db-inspect.ts",
    "staging:db:inspect:pooled": "tsx --env-file=.env.staging.local scripts/db-inspect.ts --pooled",
    "staging:db:environment": "tsx --env-file=.env.staging.local scripts/db-environment.ts --expect staging",
    "staging:migrate:status": "node --env-file=.env.staging.local node_modules/prisma/build/index.js migrate status",
    "drill:migrations": "tsx scripts/drills/migrations.ts",
    "drill:backup": "tsx scripts/drills/backup.ts",
    "ci:local": "tsx scripts/local-ci.ts",
    "test:staging": "playwright test --config playwright.staging.config.ts",
    "ops:prune": "tsx scripts/ops-prune.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "7.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "framer-motion": "14.11.1",
    "hanzi-writer": "3.7.3",
    "hanzi-writer-data": "2.0.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "18.0.10",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
