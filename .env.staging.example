# HanziQuest STAGING configuration template (M11). PLACEHOLDERS ONLY — never commit real values.
#
# Where each value lives (docs/M11_STAGING_CONFIGURATION.md):
#   [render]  Render → hanziquest-staging → Environment   (render.staging.yaml sets the non-secret ones)
#   [github]  GitHub → Settings → Environments → staging → Secrets  (deploy-staging.yml, backup.yml)
#   [owner]   the owner's machine / password manager only
# Every secret here is STAGING-ONLY and must differ from production's. The start-up check
# refuses any value that still contains REPLACE_ME.

# ── Identity ───────────────────────────────────────────────────────────────────── [render]
NODE_ENV="production"                      # always production on a deployed server
APP_ENV="staging"                          # required on Render; drives the banner, logs and DB guard

# ── Database (Neon project "hanziquest-staging", Free plan) ──────────────────────
# [render] pooled URL for the app (host contains "-pooler"), TLS required
DATABASE_URL="postgresql://REPLACE_ME_user:REPLACE_ME_password@REPLACE_ME-pooler.REPLACE_ME_region.aws.neon.tech/hanziquest?sslmode=require"
# [render] connections per instance (1-100). Small: Neon Free + one free instance.
DATABASE_POOL_MAX="3"
# [github: DIRECT_DATABASE_URL] direct (unpooled) URL for migrations, backups and the DB guard.
# Not needed on Render: migrations run from the deploy workflow.
MIGRATE_DATABASE_URL="postgresql://REPLACE_ME_user:REPLACE_ME_password@REPLACE_ME.REPLACE_ME_region.aws.neon.tech/hanziquest?sslmode=require"

# ── Authentication ───────────────────────────────────────────────────────────── [render]
AUTH_SECRET="REPLACE_ME_with_openssl_rand_base64_32"      # new value, never production's
AUTH_URL="https://REPLACE_ME-staging.onrender.com"         # the staging origin, https only
AUTH_TRUST_HOST="true"                                     # Render terminates TLS in front of the app

# ── Proxy and limits ─────────────────────────────────────────────────────────── [render]
TRUSTED_PROXY_HOPS="1"            # confirm on first deploy (docs/M11_STAGING_ACCEPTANCE.md, IP check)
REGISTER_LIMIT_PER_HOUR="20"      # per IP; above the default 5 so the acceptance suite can run a few times an hour
# RATE_LIMIT_STORE                # leave unset (PostgreSQL store)

# ── Safety defaults: LEAVE UNSET on staging ─────────────────────────────────────
# REGISTRATION_MODE               # unset = invite-only; "open" is refused on staging
# PASSWORD_RESET_LINKS            # unset = off; the reset procedure is not approved

# ── Release and monitoring ───────────────────────────────────────────────────── [render]
# APP_RELEASE                     # leave unset on Render: RENDER_GIT_COMMIT is used
# SENTRY_DSN                      # optional; a separate staging project if used

# ── Deploy workflow (GitHub environment "staging" secrets) ───────────────────── [github]
# DEPLOY_HOOK_URL="https://api.render.com/deploy/srv-REPLACE_ME?key=REPLACE_ME"   # secret
# APP_URL="https://REPLACE_ME-staging.onrender.com"
# DIRECT_DATABASE_URL=<same as MIGRATE_DATABASE_URL above>
# BACKUP_AGE_RECIPIENT="age1REPLACE_ME"        # STAGING public key; private key stays with the owner

# ── First seed only (owner's machine, then remove) ─────────────────────────────── [owner]
# SEED_ADMIN_EMAIL="REPLACE_ME+staging-admin@example.com"   # an address the owner controls
# SEED_ADMIN_PASSWORD="REPLACE_ME_generated"                # generated, stored in the password manager

# ── Acceptance suite (owner's machine; npm run test:staging) ──────────────────── [owner]
# STAGING_BASE_URL="https://REPLACE_ME-staging.onrender.com"
# STAGING_INVITE_CODE="HQ-REPLACE-ME000"        # multi-use, expires in 1 day, label "acceptance"
# STAGING_ADMIN_EMAIL / STAGING_ADMIN_PASSWORD  # the seeded staging admin
